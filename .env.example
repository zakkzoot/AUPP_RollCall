# Copy to .env.local for local dev, or set these in Vercel's project settings.
# All four are required — the app shows a "Setup needed" screen if any is blank.
# The service_role key is NOT here on purpose: it belongs only to Edge Functions.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → anon / public key (safe in the browser)
VITE_SUPABASE_ANON_KEY=your-anon-key

# Deployed Edge Function URLs (supabase functions deploy checkin / export)
VITE_CHECKIN_FN_URL=https://your-project-ref.supabase.co/functions/v1/checkin
VITE_EXPORT_FN_URL=https://your-project-ref.supabase.co/functions/v1/export
